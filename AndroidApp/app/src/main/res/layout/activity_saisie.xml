<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#0B132B"
    android:padding="24dp">

    <!-- العنوان -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DOUANE TEMPORELLE"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- خانة الاسم -->
    <EditText
        android:id="@+id/et_nom_gg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Nom du voyageur"
        android:textColor="#FFFFFF"
        android:textColorHint="#A0A0A0"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp"/>

    <!-- خانة سنة الولادة -->
    <EditText
        android:id="@+id/et_naissance_gg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Année de naissance (ex: 1990)"
        android:textColor="#FFFFFF"
        android:textColorHint="#A0A0A0"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <!-- خانة سنة الوجهة -->
    <EditText
        android:id="@+id/et_destination_gg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Année de destination (ex: 2050)"
        android:textColor="#FFFFFF"
        android:textColorHint="#A0A0A0"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <!-- نص توضيحي للـ Spinner -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Motif du voyage"
        android:textColor="#FFD700"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <!-- قائمة الأسباب (Spinner) -->
    <Spinner
        android:id="@+id/sp_motif_gg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="32dp"/>

    <!-- زر الفحص بالأحمر -->
    <Button
        android:id="@+id/btn_inspecter_gg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Inspecter le profil"
        android:backgroundTint="#FFB300"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"/>

</LinearLayout>